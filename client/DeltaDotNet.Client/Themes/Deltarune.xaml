<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         DeltaDotNet default theme: "Dark World"
         Styled after DELTARUNE: pure black, thick white square borders,
         a warm-yellow highlight and a pixel font. Everything uses
         DynamicResource so a .ddntheme package can override it at runtime.
         ===================================================================== -->

    <Color x:Key="DdnBackgroundColor">#FF000000</Color>
    <Color x:Key="DdnPanelColor">#FF000000</Color>
    <Color x:Key="DdnBorderColor">#FFFFFFFF</Color>
    <Color x:Key="DdnTextColor">#FFFFFFFF</Color>
    <Color x:Key="DdnMutedColor">#FF8C8C8C</Color>
    <Color x:Key="DdnAccentColor">#FFFFF23A</Color>
    <Color x:Key="DdnAccent2Color">#FF32B0FF</Color>
    <Color x:Key="DdnDangerColor">#FFFF3B3B</Color>
    <Color x:Key="DdnSuccessColor">#FF3BE05A</Color>
    <Color x:Key="DdnFieldColor">#FF000000</Color>

    <SolidColorBrush x:Key="DdnBackgroundBrush" Color="{DynamicResource DdnBackgroundColor}" />
    <SolidColorBrush x:Key="DdnPanelBrush" Color="{DynamicResource DdnPanelColor}" />
    <SolidColorBrush x:Key="DdnBorderBrush" Color="{DynamicResource DdnBorderColor}" />
    <SolidColorBrush x:Key="DdnTextBrush" Color="{DynamicResource DdnTextColor}" />
    <SolidColorBrush x:Key="DdnMutedBrush" Color="{DynamicResource DdnMutedColor}" />
    <SolidColorBrush x:Key="DdnAccentBrush" Color="{DynamicResource DdnAccentColor}" />
    <SolidColorBrush x:Key="DdnAccent2Brush" Color="{DynamicResource DdnAccent2Color}" />
    <SolidColorBrush x:Key="DdnDangerBrush" Color="{DynamicResource DdnDangerColor}" />
    <SolidColorBrush x:Key="DdnSuccessBrush" Color="{DynamicResource DdnSuccessColor}" />
    <SolidColorBrush x:Key="DdnFieldBrush" Color="{DynamicResource DdnFieldColor}" />

    <ImageBrush x:Key="DdnBackgroundImageBrush" ImageSource="{x:Null}" Stretch="UniformToFill" Opacity="1" />

    <!-- App.OnStartup replaces this with a pixel .ttf from Assets\Fonts if present. -->
    <FontFamily x:Key="DdnFont">Consolas, Lucida Console, Courier New, monospace</FontFamily>

    <!-- ===================== base text ===================== -->
    <Style x:Key="DdnText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="DdnTitle" TargetType="TextBlock" BasedOn="{StaticResource DdnText}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="DdnMuted" TargetType="TextBlock" BasedOn="{StaticResource DdnText}">
        <Setter Property="Foreground" Value="{DynamicResource DdnMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- ===================== bordered box ===================== -->
    <Style x:Key="DdnBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DdnPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== buttons ===================== -->
    <!-- Deltarune menu feel: black box, white border, and on hover the whole
         cell fills with the accent and the text goes black, like a selection. -->
    <Style x:Key="DdnButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource DdnPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Heart" Text="&#x2665; " Visibility="Hidden"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource DdnDangerBrush}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DdnAccentBrush}" />
                            <Setter TargetName="Heart" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="#FF000000" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Heart" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DdnDangerButton" TargetType="Button" BasedOn="{StaticResource DdnButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource DdnDangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DdnDangerBrush}" />
    </Style>

    <!-- ===================== text inputs ===================== -->
    <Style x:Key="DdnInput" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource DdnFieldBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DdnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DdnPassword" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource DdnFieldBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DdnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== combo box (this was the white one) ===================== -->
    <Style x:Key="DdnComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{DynamicResource DdnFieldBrush}"
                            BorderBrush="{DynamicResource DdnBorderBrush}"
                            BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="&#x25BC;" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DdnAccentBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DdnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DdnComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{DynamicResource DdnFieldBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DdnAccentBrush}" />
                            <Setter Property="Foreground" Value="#FF000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DdnCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource DdnComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{DynamicResource DdnComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="Sel"
                                          Margin="10,0,30,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{DynamicResource DdnTextBrush}" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource DdnFieldBrush}"
                                    BorderBrush="{DynamicResource DdnBorderBrush}"
                                    BorderThickness="2"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="320"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== check box ===================== -->
    <Style x:Key="DdnCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="20" Height="20"
                                Background="{DynamicResource DdnFieldBrush}"
                                BorderBrush="{DynamicResource DdnBorderBrush}"
                                BorderThickness="2" VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Tick" Text="&#x2665;" FontSize="12" Visibility="Hidden"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DdnDangerBrush}" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DdnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== slider ===================== -->
    <Style x:Key="DdnSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" Background="#FF1A1A1A" BorderBrush="{DynamicResource DdnBorderBrush}" BorderThickness="1" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Width="16" Height="22" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource DdnAccentBrush}"
                                                    BorderBrush="{DynamicResource DdnBorderBrush}" BorderThickness="2"
                                                    SnapsToDevicePixels="True" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== list box ===================== -->
    <Style x:Key="DdnListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF161616" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DdnAccentBrush}" />
                            <Setter Property="Foreground" Value="#FF000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DdnList" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource DdnFieldBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource DdnListItem}" />
    </Style>

    <!-- ===================== scroll bar ===================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#FF000000" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="#FF000000">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#FF3A3A3A" BorderBrush="{DynamicResource DdnBorderBrush}"
                                                    BorderThickness="1" SnapsToDevicePixels="True" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="12" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== tab control (Settings) ===================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="{DynamicResource DdnPanelBrush}"
                            BorderBrush="{DynamicResource DdnBorderBrush}" BorderThickness="3"
                            Margin="0,0,6,0" Padding="16,7" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DdnAccentBrush}" />
                            <Setter Property="Foreground" Value="#FF000000" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DdnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
