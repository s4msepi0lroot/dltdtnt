<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== DeltaDotNet default theme: "Dark World" (Deltarune styled) =====
         Every brush below is overridable at runtime by a .ddntheme package,
         which is why views must reference them with DynamicResource.       -->

    <Color x:Key="DdnBackgroundColor">#FF000000</Color>
    <Color x:Key="DdnPanelColor">#FF0B0B12</Color>
    <Color x:Key="DdnBorderColor">#FFFFFFFF</Color>
    <Color x:Key="DdnTextColor">#FFFFFFFF</Color>
    <Color x:Key="DdnMutedColor">#FF9A9AB0</Color>
    <Color x:Key="DdnAccentColor">#FFFFD23F</Color>
    <Color x:Key="DdnAccent2Color">#FF7A5CFF</Color>
    <Color x:Key="DdnDangerColor">#FFFF4D5E</Color>
    <Color x:Key="DdnSuccessColor">#FF49E36B</Color>

    <SolidColorBrush x:Key="DdnBackgroundBrush" Color="{StaticResource DdnBackgroundColor}" />
    <SolidColorBrush x:Key="DdnPanelBrush" Color="{StaticResource DdnPanelColor}" />
    <SolidColorBrush x:Key="DdnBorderBrush" Color="{StaticResource DdnBorderColor}" />
    <SolidColorBrush x:Key="DdnTextBrush" Color="{StaticResource DdnTextColor}" />
    <SolidColorBrush x:Key="DdnMutedBrush" Color="{StaticResource DdnMutedColor}" />
    <SolidColorBrush x:Key="DdnAccentBrush" Color="{StaticResource DdnAccentColor}" />
    <SolidColorBrush x:Key="DdnAccent2Brush" Color="{StaticResource DdnAccent2Color}" />
    <SolidColorBrush x:Key="DdnDangerBrush" Color="{StaticResource DdnDangerColor}" />
    <SolidColorBrush x:Key="DdnSuccessBrush" Color="{StaticResource DdnSuccessColor}" />

    <!-- Background image layer (replaced by themes). Transparent by default. -->
    <ImageBrush x:Key="DdnBackgroundImageBrush" ImageSource="{x:Null}" Stretch="UniformToFill" Opacity="1" />

    <FontFamily x:Key="DdnFont">Consolas, Courier New, monospace</FontFamily>

    <!-- ===== Base text ===== -->
    <Style x:Key="DdnText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="DdnTitle" TargetType="TextBlock" BasedOn="{StaticResource DdnText}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="DdnMuted" TargetType="TextBlock" BasedOn="{StaticResource DdnText}">
        <Setter Property="Foreground" Value="{DynamicResource DdnMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== Deltarune style bordered box ===== -->
    <Style x:Key="DdnBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DdnPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="DdnButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DdnAccentBrush}" />
                            <Setter Property="Foreground" Value="#FF000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DdnDangerButton" TargetType="Button" BasedOn="{StaticResource DdnButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource DdnDangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DdnDangerBrush}" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="DdnInput" TargetType="TextBox">
        <Setter Property="Background" Value="#FF06060A" />
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="DdnPassword" TargetType="PasswordBox">
        <Setter Property="Background" Value="#FF06060A" />
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="DdnCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="DdnCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="DdnSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource DdnAccentBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
    </Style>

    <Style x:Key="DdnList" TargetType="ListBox">
        <Setter Property="Background" Value="#FF06060A" />
        <Setter Property="Foreground" Value="{DynamicResource DdnTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DdnBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource DdnFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

</ResourceDictionary>
