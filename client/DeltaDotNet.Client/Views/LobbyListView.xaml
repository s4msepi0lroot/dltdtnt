<UserControl x:Class="DeltaDotNet.Client.Views.LobbyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- ===== lobby list ===== -->
        <Border Grid.Column="0" Style="{DynamicResource DdnBox}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock x:Name="ListTitle" Text="* LOBBIES" Style="{DynamicResource DdnTitle}" />
                    <Button x:Name="RefreshBtn" Content="REFRESH" Style="{DynamicResource DdnButton}" Click="Refresh_Click" Margin="18,0,0,8" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListPanel" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="JoinByLabel" Text="Join by ID:" Style="{DynamicResource DdnText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="JoinIdBox" Style="{DynamicResource DdnInput}" Width="140" Margin="0,0,8,0" />
                    <TextBlock x:Name="JoinPassLabel" Text="password:" Style="{DynamicResource DdnText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="JoinPassBox" Style="{DynamicResource DdnInput}" Width="140" Margin="0,0,8,0" />
                    <Button x:Name="JoinByBtn" Content="JOIN" Style="{DynamicResource DdnButton}" Click="JoinById_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== create lobby ===== -->
        <Border Grid.Column="1" Style="{DynamicResource DdnBox}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="CreateTitle" Text="* CREATE A LOBBY" Style="{DynamicResource DdnTitle}" />

                    <TextBlock x:Name="NameLabel" Text="Lobby name" Style="{DynamicResource DdnMuted}" />
                    <TextBox x:Name="NameBox" Style="{DynamicResource DdnInput}" />

                    <TextBlock x:Name="CountLabel" Text="Number of players" Style="{DynamicResource DdnMuted}" />
                    <ComboBox x:Name="PlayersBox" Style="{DynamicResource DdnCombo}">
                        <ComboBoxItem Content="2 players" Tag="2" IsSelected="True" />
                        <ComboBoxItem Content="3 players" Tag="3" />
                        <ComboBoxItem Content="4 players" Tag="4" />
                        <ComboBoxItem Content="5 players" Tag="5" />
                        <ComboBoxItem Content="6 players" Tag="6" />
                        <ComboBoxItem Content="7 players" Tag="7" />
                        <ComboBoxItem Content="8 players" Tag="8" />
                    </ComboBox>

                    <TextBlock x:Name="AccessLabel" Text="Access" Style="{DynamicResource DdnMuted}" />
                    <ComboBox x:Name="VisBox" Style="{DynamicResource DdnCombo}" SelectionChanged="Vis_Changed">
                        <ComboBoxItem x:Name="VisOpenItem" Content="Open - anybody can join" Tag="open" IsSelected="True" />
                        <ComboBoxItem x:Name="VisClosedItem" Content="Closed - password or guest list" Tag="closed" />
                    </ComboBox>

                    <StackPanel x:Name="ClosedPanel" Visibility="Collapsed">
                        <TextBlock x:Name="PassHint" Text="Password (leave empty to use the guest list only)" Style="{DynamicResource DdnMuted}" TextWrapping="Wrap" />
                        <TextBox x:Name="PassBox" Style="{DynamicResource DdnInput}" />
                        <TextBlock x:Name="AllowHint" Text="Guest list: logins separated by a comma" Style="{DynamicResource DdnMuted}" TextWrapping="Wrap" />
                        <TextBox x:Name="AllowBox" Style="{DynamicResource DdnInput}" />
                    </StackPanel>

                    <Button x:Name="CreateBtn" Content="CREATE" Style="{DynamicResource DdnButton}" Click="Create_Click" Margin="0,10,0,0" />

                    <TextBlock x:Name="HostNote" Text="You become the host: your PC runs the game and streams it. Everyone else only needs the client."
                               Style="{DynamicResource DdnMuted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock x:Name="MotdText" Style="{DynamicResource DdnText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
