<UserControl x:Class="DeltaDotNet.Client.Views.LobbyRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource DdnBox}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TitleText" Text="* LOBBY" Style="{DynamicResource DdnTitle}" />
                    <TextBlock x:Name="SubText" Style="{DynamicResource DdnMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MembersPanel" />
                </ScrollViewer>

                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="StartBtn" Content="START THE GAME" Style="{DynamicResource DdnButton}" Click="Start_Click" />
                    <Button x:Name="WatchBtn" Content="OPEN THE STREAM" Style="{DynamicResource DdnButton}" Click="Watch_Click" />
                    <Button x:Name="LeaveBtn" Content="LEAVE" Style="{DynamicResource DdnButton}" Click="Leave_Click" />
                    <Button x:Name="CloseBtn" Content="CLOSE THE LOBBY" Style="{DynamicResource DdnDangerButton}" Click="CloseLobby_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{DynamicResource DdnBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="* CHAT" Style="{DynamicResource DdnTitle}" />

                <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatPanel" />
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatBox" Grid.Column="0" Style="{DynamicResource DdnInput}" KeyDown="ChatBox_KeyDown" />
                    <Button Grid.Column="1" Content="SEND" Style="{DynamicResource DdnButton}" Click="Send_Click" Margin="8,0,0,8" />
                </Grid>

                <StackPanel Grid.Row="3" x:Name="HostPanel">
                    <TextBlock Text="* HOST TOOLS" Style="{DynamicResource DdnTitle}" FontSize="20" />
                    <WrapPanel>
                        <Button Content="RENAME" Style="{DynamicResource DdnButton}" Click="Rename_Click" />
                        <Button Content="ACCESS" Style="{DynamicResource DdnButton}" Click="Access_Click" />
                        <Button Content="SLOTS" Style="{DynamicResource DdnButton}" Click="Slots_Click" />
                        <Button Content="UNBAN" Style="{DynamicResource DdnButton}" Click="Unban_Click" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
