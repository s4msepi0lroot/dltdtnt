<Window x:Class="DeltaDotNet.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeltaDotNet" Height="760" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DdnBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <!-- theme background image layer -->
        <Rectangle Fill="{DynamicResource DdnBackgroundImageBrush}" />

        <!-- Everything lives on a 1280x720 design surface. The Viewbox keeps the
             whole interface inside the window no matter how it is resized. -->
        <Viewbox x:Name="RootBox" Stretch="Uniform">
            <Grid Width="1280" Height="720">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <!-- ================= top bar ================= -->
                <Border Grid.Row="0" Background="{DynamicResource DdnPanelBrush}"
                        BorderBrush="{DynamicResource DdnBorderBrush}" BorderThickness="0,0,0,3">
                    <Grid Margin="14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Logo: Assets\logo.png if present, otherwise the text fallback -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="LogoImage" Height="46" Margin="0,0,12,0"
                                   Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock x:Name="LogoText" Text="DELTA.DOTNET" FontSize="30"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource DdnFont}"
                                       Foreground="{DynamicResource DdnAccentBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" x:Name="NavPanel">
                            <Button x:Name="NavLobbies" Content="LOBBIES" Style="{DynamicResource DdnButton}" Click="NavLobbies_Click" />
                            <Button x:Name="NavSettings" Content="SETTINGS" Style="{DynamicResource DdnButton}" Click="NavSettings_Click" />
                            <Button x:Name="NavAdmin" Content="ADMIN" Style="{DynamicResource DdnButton}" Click="NavAdmin_Click" Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UserLabel" Text="" VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontFamily="{DynamicResource DdnFont}" FontSize="16"
                                       Foreground="{DynamicResource DdnTextBrush}" />
                            <Button x:Name="NavLogout" Content="EXIT" Style="{DynamicResource DdnButton}" Click="NavLogout_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= page host ================= -->
                <ContentControl Grid.Row="1" x:Name="PageHost" Margin="0" />

                <!-- ================= status bar ================= -->
                <Border Grid.Row="2" Background="{DynamicResource DdnPanelBrush}">
                    <TextBlock x:Name="StatusText" Margin="12,3" FontSize="12"
                               FontFamily="{DynamicResource DdnFont}"
                               Foreground="{DynamicResource DdnMutedBrush}" Text="* ready" />
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
