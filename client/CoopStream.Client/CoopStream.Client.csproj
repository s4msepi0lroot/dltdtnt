<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CoopStream</AssemblyName>
    <RootNamespace>CoopStream.Client</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Сборка в один exe без установленного .NET у пользователя -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!--
      ВАЖНО: должно быть false.
      В режиме globalization-invariant WinForms падает с CultureNotFoundException
      ("1049 (0x0419) is an invalid culture identifier") при переключении раскладки
      клавиатуры, потому что InputLanguageChanged не может создать CultureInfo для
      русской раскладки. Включение ICU добавляет ~30 МБ к self-contained сборке,
      но это единственный корректный способ поддержать любые раскладки.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
