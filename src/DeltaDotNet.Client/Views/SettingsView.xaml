<UserControl x:Class="DeltaDotNet.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource DeltaBox}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleText}" Text="* Settings" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button Content="SAVE" Width="140" Click="Save_Click" />
                <Button Content="Back" Width="120" Margin="8,4,0,4" Click="Back_Click" />
                <TextBlock x:Name="MessageText" Margin="14,10,0,0" Style="{StaticResource SubtleText}" Text="" />
            </StackPanel>

            <TabControl Background="Transparent" Margin="0,8">

                <!-- ============ QUALITY ============ -->
                <TabItem Header="Quality">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Preset" />
                            <ComboBox x:Name="PresetBox" SelectionChanged="Preset_Changed">
                                <ComboBoxItem Content="Potato" />
                                <ComboBoxItem Content="Low" />
                                <ComboBoxItem Content="Medium" />
                                <ComboBoxItem Content="High" />
                                <ComboBoxItem Content="Ultra" />
                                <ComboBoxItem Content="Custom" />
                            </ComboBox>

                            <TextBlock x:Name="FpsLabel" Margin="0,10,0,0" Text="Frame rate" />
                            <Slider x:Name="FpsSlider" Minimum="5" Maximum="60" TickFrequency="1"
                                    ValueChanged="Quality_Changed" />

                            <TextBlock x:Name="ScaleLabel" Text="Resolution scale" />
                            <Slider x:Name="ScaleSlider" Minimum="25" Maximum="100" TickFrequency="5"
                                    ValueChanged="Quality_Changed" />

                            <TextBlock x:Name="JpegLabel" Text="Image quality" />
                            <Slider x:Name="JpegSlider" Minimum="20" Maximum="95" TickFrequency="5"
                                    ValueChanged="Quality_Changed" />

                            <CheckBox x:Name="StatsBox" Content="Show stream statistics while playing" />
                            <TextBlock Style="{StaticResource SubtleText}"
                                       Text="Higher values look better but need more upload bandwidth on the host." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ CONTROLS ============ -->
                <TabItem Header="Controls">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Player slot" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="SlotBox" Width="160" SelectedIndex="0" SelectionChanged="Slot_Changed">
                                    <ComboBoxItem Content="Player 1" />
                                    <ComboBoxItem Content="Player 2" />
                                    <ComboBoxItem Content="Player 3" />
                                    <ComboBoxItem Content="Player 4" />
                                </ComboBox>
                                <ComboBox x:Name="LayerBox" Width="320" Margin="12,4,0,4" SelectedIndex="0"
                                          SelectionChanged="Slot_Changed">
                                    <ComboBoxItem Content="My keyboard (what I press)" />
                                    <ComboBoxItem Content="Game keys (what the host injects)" />
                                </ComboBox>
                                <Button Content="Defaults" Width="120" Margin="12,4,0,4" Click="Defaults_Click" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,6,0,6"
                                       Text="Click a button, then press the key you want. Esc clears the binding." />

                            <ItemsControl x:Name="BindingItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ CAPTURE ============ -->
                <TabItem Header="Capture">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="What the host streams" />
                            <ComboBox x:Name="CaptureModeBox" SelectedIndex="0">
                                <ComboBoxItem Content="Game window (recommended)" />
                                <ComboBoxItem Content="Whole screen" />
                            </ComboBox>

                            <TextBlock Text="Window title contains" Margin="0,10,0,0" />
                            <TextBox x:Name="WindowTitleBox" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="WindowListBox" Width="380" />
                                <Button Content="Refresh list" Width="140" Margin="8,4,0,4" Click="RefreshWindows_Click" />
                                <Button Content="Use selected" Width="150" Margin="8,4,0,4" Click="UseWindow_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ THEMES ============ -->
                <TabItem Header="Themes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Installed themes (.ddntheme)" />
                            <ListBox x:Name="ThemeList" Height="170" DisplayMemberPath="Label" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply" Width="120" Click="ApplyTheme_Click" />
                                <Button Content="Import file..." Width="160" Margin="8,4,0,4" Click="ImportTheme_Click" />
                                <Button Content="Open themes folder" Width="200" Margin="8,4,0,4" Click="OpenThemesFolder_Click" />
                                <Button Content="Built-in theme" Width="170" Margin="8,4,0,4" Click="DefaultTheme_Click" />
                            </StackPanel>

                            <CheckBox x:Name="MusicBox" Content="Play theme background music" Margin="0,10,0,0" />
                            <TextBlock x:Name="VolumeLabel" Text="Music volume" />
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                    ValueChanged="Volume_Changed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ ACCOUNT ============ -->
                <TabItem Header="Account">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Server URL" />
                            <TextBox x:Name="ServerBox" />
                            <CheckBox x:Name="RememberBox" Content="Stay signed in on this PC" />
                            <TextBlock x:Name="AccountText" Style="{StaticResource SubtleText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
