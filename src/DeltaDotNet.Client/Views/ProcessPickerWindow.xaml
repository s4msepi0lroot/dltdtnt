<Window x:Class="DeltaDotNet.Client.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DeltaDotNet.Client.Localization"
        Title="{loc:Tr picker.title}"
        Width="520" Height="560" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <!-- Cheat Engine style picker: tabs (Applications / Processes / Windows),
         one flat list, double-click or Attach to choose the target. -->
    <Border Style="{StaticResource DeltaBox}" Margin="6" Padding="10">
        <DockPanel>
            <TabControl x:Name="Tabs" DockPanel.Dock="Top" SelectionChanged="Tabs_Changed" Height="42">
                <TabItem Header="{loc:Tr picker.tab.apps}" />
            </TabControl>

            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Style="{StaticResource SubtleText}" Text="{loc:Tr picker.hint}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr refresh}" Width="110" Style="{StaticResource SmallButton}"
                            Click="Refresh_Click" />
                    <Button Content="{loc:Tr picker.attach}" Width="110" Margin="8,4,0,4" IsDefault="True"
                            Click="Attach_Click" />
                    <Button Content="{loc:Tr cancel}" Width="110" Margin="8,4,0,4" IsCancel="True" />
                </StackPanel>
            </StackPanel>

            <DockPanel Margin="0,8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr picker.filter}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="FilterBox" Width="300" TextChanged="Filter_Changed" />
                </StackPanel>
                <ListBox x:Name="ItemList" Margin="0,8,0,0" DisplayMemberPath="Display"
                         MouseDoubleClick="Attach_Click" />
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
