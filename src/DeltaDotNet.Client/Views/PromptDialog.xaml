<Window x:Class="DeltaDotNet.Client.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DeltaDotNet.Client.Localization"
        Title="DeltaDotNet" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Border Style="{StaticResource DeltaBox}">
        <StackPanel>
            <TextBlock x:Name="PromptText" Margin="0,0,0,8" />
            <TextBox x:Name="InputBox" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="{loc:Tr ok}" MinWidth="90" IsDefault="True" Click="Ok_Click" />
                <Button Content="{loc:Tr cancel}" MinWidth="90" Margin="8,4,0,4" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
