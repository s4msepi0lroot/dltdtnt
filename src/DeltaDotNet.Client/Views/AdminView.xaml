<UserControl x:Class="DeltaDotNet.Client.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource DeltaBox}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleText}" Text="* Admin panel" />
            <TextBlock DockPanel.Dock="Top" x:Name="StatsText" Style="{StaticResource SubtleText}" Text="" />

            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock x:Name="MessageText" Style="{StaticResource SubtleText}" Text="" />
                <Button Content="Back" Width="120" HorizontalAlignment="Left" Click="Back_Click" />
            </StackPanel>

            <TabControl Background="Transparent" Margin="0,8">

                <TabItem Header="Users">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <TextBox x:Name="SearchBox" Width="220" />
                                <Button Content="Search" Width="110" Margin="8,4,0,4" Click="Search_Click" />
                            </StackPanel>
                            <ListBox x:Name="UserList" Margin="0,8" SelectionChanged="UserList_SelectionChanged" />
                        </DockPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock x:Name="SelectedUserText" Text="No user selected" />
                            <CheckBox x:Name="RainbowBox" Content="Rainbow nickname" />
                            <TextBlock Text="Static name color (#RRGGBB)" Margin="0,6,0,0" />
                            <TextBox x:Name="ColorBox" />
                            <TextBlock Text="Badge (e.g. VIP, MOD)" Margin="0,6,0,0" />
                            <TextBox x:Name="BadgeBox" />
                            <TextBlock Text="Role" Margin="0,6,0,0" />
                            <ComboBox x:Name="RoleBox" SelectedIndex="0">
                                <ComboBoxItem Content="user" />
                                <ComboBoxItem Content="admin" />
                            </ComboBox>
                            <Button Content="APPLY" Click="Apply_Click" />
                            <Button Content="Rename user..." Click="Rename_Click" />
                            <Button Content="Ban account..." Style="{StaticResource DangerButton}" Click="Ban_Click" />
                            <Button Content="Unban account" Click="Unban_Click" />
                            <Button Content="Delete account" Style="{StaticResource DangerButton}" Click="Delete_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Lobbies">
                    <DockPanel Margin="10">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Button Content="Refresh" Width="120" Click="RefreshLobbies_Click" />
                            <Button Content="Force close selected" Width="220" Margin="8,4,0,4"
                                    Style="{StaticResource DangerButton}" Click="CloseLobby_Click" />
                        </StackPanel>
                        <ListBox x:Name="LobbyList" Margin="0,8" DisplayMemberPath="Display" />
                    </DockPanel>
                </TabItem>

                <TabItem Header="Server">
                    <StackPanel Margin="10">
                        <TextBlock Text="Broadcast message to everyone online" />
                        <TextBox x:Name="BroadcastBox" />
                        <Button Content="SEND BROADCAST" Width="220" HorizontalAlignment="Left" Click="Broadcast_Click" />

                        <TextBlock Text="Message of the day" Margin="0,14,0,0" />
                        <TextBox x:Name="MotdBox" />
                        <Button Content="SAVE MOTD" Width="220" HorizontalAlignment="Left" Click="Motd_Click" />

                        <TextBlock x:Name="OnlineText" Style="{StaticResource SubtleText}" Margin="0,14,0,0" Text="" />
                        <Button Content="Refresh stats" Width="220" HorizontalAlignment="Left" Click="RefreshStats_Click" />
                    </StackPanel>
                </TabItem>

            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
