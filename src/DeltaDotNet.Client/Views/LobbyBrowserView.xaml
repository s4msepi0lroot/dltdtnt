<UserControl x:Class="DeltaDotNet.Client.Views.LobbyBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- lobby list -->
        <Border Grid.Column="0" Style="{StaticResource DeltaBox}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleText}" Text="* Lobbies" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Content="Refresh" Width="110" Click="Refresh_Click" />
                    <Button Content="Join selected" Width="150" Margin="8,4,0,4" Click="Join_Click" />
                    <TextBox x:Name="CodeBox" Width="110" Margin="8,4,0,4" ToolTip="Lobby code" />
                    <Button Content="Join by code" Width="140" Margin="8,4,0,4" Click="JoinByCode_Click" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="MessageText" Style="{StaticResource SubtleText}"
                           Foreground="{DynamicResource DangerBrush}" Text="" />
                <ListBox x:Name="LobbyList" Margin="0,8" DisplayMemberPath="Display"
                         MouseDoubleClick="Join_Click" />
            </DockPanel>
        </Border>

        <!-- create lobby -->
        <Border Grid.Column="1" Style="{StaticResource DeltaBox}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="* Create lobby" />

                    <TextBlock Text="Lobby name" />
                    <TextBox x:Name="NameBox" />

                    <TextBlock Text="Number of players" Margin="0,8,0,0" />
                    <ComboBox x:Name="PlayersBox" SelectedIndex="0">
                        <ComboBoxItem Content="2 players" />
                        <ComboBoxItem Content="3 players" />
                        <ComboBoxItem Content="4 players" />
                    </ComboBox>

                    <TextBlock Text="Visibility" Margin="0,8,0,0" />
                    <ComboBox x:Name="VisibilityBox" SelectedIndex="0" SelectionChanged="Visibility_Changed">
                        <ComboBoxItem Content="Open — anyone can join" />
                        <ComboBoxItem Content="Closed — restricted" />
                    </ComboBox>

                    <StackPanel x:Name="ClosedPanel" Visibility="Collapsed">
                        <TextBlock Text="Access mode" Margin="0,8,0,0" />
                        <ComboBox x:Name="AccessBox" SelectedIndex="0" SelectionChanged="Access_Changed">
                            <ComboBoxItem Content="Password" />
                            <ComboBoxItem Content="Allow list of logins" />
                        </ComboBox>

                        <StackPanel x:Name="PasswordPanel">
                            <TextBlock Text="Lobby password" Margin="0,8,0,0" />
                            <TextBox x:Name="LobbyPasswordBox" />
                        </StackPanel>

                        <StackPanel x:Name="WhitelistPanel" Visibility="Collapsed">
                            <TextBlock Text="Allowed logins (comma separated)" Margin="0,8,0,0" />
                            <TextBox x:Name="WhitelistBox" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Stream quality" Margin="0,8,0,0" />
                    <ComboBox x:Name="QualityBox" SelectedIndex="2">
                        <ComboBoxItem Content="Potato" />
                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Medium" />
                        <ComboBoxItem Content="High" />
                        <ComboBoxItem Content="Ultra" />
                        <ComboBoxItem Content="Use my settings" />
                    </ComboBox>

                    <Button Content="CREATE" Margin="0,14,0,0" Click="Create_Click" />
                    <TextBlock Style="{StaticResource SubtleText}" Margin="0,8,0,0"
                               Text="You become the host: your screen is streamed and guest keys are injected into the game on your PC." />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
