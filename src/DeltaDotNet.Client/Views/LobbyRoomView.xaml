<UserControl x:Class="DeltaDotNet.Client.Views.LobbyRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DeltaDotNet.Client.Localization">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- players / host controls -->
        <Border Grid.Column="0" Style="{StaticResource DeltaBox}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Style="{StaticResource TitleText}" Text="" />
                <TextBlock DockPanel.Dock="Top" x:Name="InfoText" Style="{StaticResource SubtleText}" Text="" />

                <WrapPanel DockPanel.Dock="Bottom">
                    <Button x:Name="StartButton" Content="{loc:Tr room.start}" MinWidth="150" Click="Start_Click" />
                    <Button x:Name="ReadyButton" Content="{loc:Tr room.ready}" MinWidth="150" Margin="8,4,0,4" Click="Ready_Click" />
                    <Button x:Name="KickButton" Content="{loc:Tr room.kick}" MinWidth="110" Margin="8,4,0,4" Click="Kick_Click" />
                    <Button x:Name="BanButton" Content="{loc:Tr room.ban}" MinWidth="110" Margin="8,4,0,4" Click="Ban_Click" />
                    <Button x:Name="UnbanButton" Content="{loc:Tr room.unban}" MinWidth="130" Margin="8,4,0,4" Click="Unban_Click" />
                    <Button x:Name="LeaveButton" Content="{loc:Tr room.leave}" MinWidth="130" Margin="8,4,0,4" Click="Leave_Click" />
                    <Button x:Name="CloseButton" Content="{loc:Tr room.close}" MinWidth="150" Margin="8,4,0,4"
                            Style="{StaticResource DangerButton}" Click="Close_Click" />
                </WrapPanel>

                <ListBox x:Name="MemberList" Margin="0,8" DisplayMemberPath="Display" />
            </DockPanel>
        </Border>

        <!-- chat -->
        <Border Grid.Column="1" Style="{StaticResource DeltaBox}" Width="380">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleText}" FontSize="20" Text="{loc:Tr room.chat}" />

                <!-- FIX: the Send button used to be pushed outside the panel.
                     DockPanel gives the button its natural width and lets the
                     text box take everything that is left over. -->
                <DockPanel DockPanel.Dock="Bottom" LastChildFill="True">
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="{loc:Tr room.send}"
                            MinWidth="90" Margin="8,4,0,4" Click="Send_Click" />
                    <TextBox x:Name="ChatInput" KeyDown="ChatInput_KeyDown" />
                </DockPanel>

                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Margin="0,4">
                    <StackPanel x:Name="ChatPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
