<UserControl x:Class="DeltaDotNet.Client.Views.LobbyRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource DeltaBox}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="TitleTextBlock" Style="{StaticResource TitleText}" Text="* Lobby" />
                <TextBlock DockPanel.Dock="Top" x:Name="InfoText" Style="{StaticResource SubtleText}" Text="" />

                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="START GAME" Width="160" Click="Start_Click" />
                        <Button x:Name="ReadyButton" Content="READY" Width="120" Margin="8,4,0,4" Click="Ready_Click" />
                        <Button Content="Leave" Width="110" Margin="8,4,0,4" Click="Leave_Click" />
                        <Button x:Name="CloseLobbyButton" Style="{StaticResource DangerButton}"
                                Content="CLOSE LOBBY" Width="160" Margin="8,4,0,4" Click="CloseLobby_Click" />
                    </StackPanel>
                    <TextBlock x:Name="MessageText" Foreground="{DynamicResource DangerBrush}"
                               Style="{StaticResource SubtleText}" Text="" />
                </StackPanel>

                <Grid Margin="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="MemberList" Grid.Row="0" DisplayMemberPath="Display" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" x:Name="HostTools" Visibility="Collapsed">
                        <Button Content="Kick" Width="100" Click="Kick_Click" />
                        <Button Content="Ban" Width="100" Margin="8,4,0,4" Style="{StaticResource DangerButton}" Click="Ban_Click" />
                        <Button Content="Unban..." Width="120" Margin="8,4,0,4" Click="Unban_Click" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource DeltaBox}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleText}" FontSize="20" Text="* Chat" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <TextBox x:Name="ChatBox" Width="230" KeyDown="ChatBox_KeyDown" />
                    <Button Content="Send" Width="80" Margin="8,4,0,4" Click="SendChat_Click" />
                </StackPanel>
                <ListBox x:Name="ChatList" Margin="0,8" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
