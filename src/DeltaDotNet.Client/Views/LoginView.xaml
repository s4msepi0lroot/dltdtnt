<UserControl x:Class="DeltaDotNet.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DeltaDotNet.Client.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource DeltaBox}" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="{loc:Tr login.title}" />
                <TextBlock Style="{StaticResource SubtleText}" Text="{loc:Tr login.hint}" />

                <TextBlock Margin="0,12,0,0" Text="{loc:Tr login.server}" />
                <TextBox x:Name="ServerBox" />

                <TextBlock Margin="0,8,0,0" Text="{loc:Tr login.username}" />
                <TextBox x:Name="UsernameBox" />

                <TextBlock Margin="0,8,0,0" Text="{loc:Tr login.password}" />
                <PasswordBox x:Name="PasswordBox" />

                <CheckBox x:Name="RememberBox" Content="{loc:Tr login.remember}" IsChecked="True" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="LoginButton" Content="{loc:Tr login.login}" MinWidth="150" Click="Login_Click" IsDefault="True" />
                    <Button x:Name="RegisterButton" Content="{loc:Tr login.register}" MinWidth="170" Margin="10,4,0,4" Click="Register_Click" />
                </StackPanel>

                <TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="{DynamicResource DangerBrush}" Text="" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
