<Window x:Class="DeltaDotNet.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeltaDotNet"
        Width="1100" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        SizeToContent="Manual">

    <Grid>
        <!-- optional theme background image -->
        <Image x:Name="BackgroundLayer" Stretch="UniformToFill" Opacity="0.35" />

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Border Grid.Row="0" Style="{StaticResource DeltaBox}" Margin="8,8,8,4" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Replace Assets/logo.png with your own image (see Assets/README.md) -->
                    <Image x:Name="LogoImage" Grid.Column="0" Height="46" MaxWidth="260"
                           Stretch="Uniform" HorizontalAlignment="Left" />
                    <TextBlock x:Name="LogoFallback" Grid.Column="0" Style="{StaticResource TitleText}"
                               Text="DELTA DOT NET" VerticalAlignment="Center" Margin="0" Visibility="Collapsed" />

                    <TextBlock x:Name="HeaderStatus" Grid.Column="1" VerticalAlignment="Center"
                               Margin="18,0" Style="{StaticResource SubtleText}" Text="" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText" VerticalAlignment="Center" Margin="0,0,12,0" Text="" />
                        <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click" Margin="4,0" />
                        <Button x:Name="AdminButton" Content="Admin" Click="AdminButton_Click" Margin="4,0"
                                Visibility="Collapsed" />
                        <Button x:Name="LogoutButton" Content="Log out" Click="LogoutButton_Click" Margin="4,0"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- current view -->
            <ContentControl x:Name="ViewHost" Grid.Row="1" Margin="4" />

            <!-- status bar -->
            <Border Grid.Row="2" Style="{StaticResource DeltaBox}" Margin="8,4,8,8" Padding="10,6">
                <TextBlock x:Name="StatusText" Style="{StaticResource SubtleText}" Text="Ready." />
            </Border>
        </Grid>
    </Grid>
</Window>
