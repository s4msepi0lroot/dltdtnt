<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DeltaDotNet</AssemblyName>
    <RootNamespace>DeltaDotNet.Client</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>DeltaDotNet</Product>
    <!-- The icon file is a placeholder the user replaces; do not fail the build if it is missing. -->
    <NoWarn>$(NoWarn);MSB3884</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaDotNet.Core\DeltaDotNet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drop your own PNG here (see Assets/README.md). Missing files are ignored. -->
    <Resource Include="Assets\logo.png" Condition="Exists('Assets\logo.png')" />
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
    <!-- Any pixel font you drop into Assets\Fonts is embedded automatically
         (see Assets/Fonts/README.md). -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.otf" />
  </ItemGroup>

  <Target Name="DropMissingIcon" BeforeTargets="BeforeBuild" Condition="!Exists('Assets\app.ico')">
    <PropertyGroup>
      <ApplicationIcon></ApplicationIcon>
    </PropertyGroup>
  </Target>

</Project>
