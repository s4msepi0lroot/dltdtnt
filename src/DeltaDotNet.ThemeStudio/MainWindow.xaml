<Window x:Class="DeltaDotNet.ThemeStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeltaDotNet Theme Studio"
        Width="1080" Height="720" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B10" Foreground="White" FontFamily="Consolas" FontSize="14">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ editor ============ -->
        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">
                <TextBlock Text="THEME INFO" Foreground="#FFD800" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" />

                <TextBlock Text="Name" />
                <TextBox x:Name="NameBox" Text="My Deltarune theme" TextChanged="AnyChanged" />
                <TextBlock Text="Author" />
                <TextBox x:Name="AuthorBox" TextChanged="AnyChanged" />
                <TextBlock Text="Version" />
                <TextBox x:Name="VersionBox" Text="1.0.0" TextChanged="AnyChanged" />
                <TextBlock Text="Description" />
                <TextBox x:Name="DescriptionBox" TextChanged="AnyChanged" />

                <TextBlock Text="COLORS" Foreground="#FFD800" FontSize="18" FontWeight="Bold" Margin="0,14,0,6" />
                <Grid x:Name="ColorGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Background" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BackgroundColorBox" Text="#000000" TextChanged="AnyChanged" />
                    <Border    Grid.Row="0" Grid.Column="2" x:Name="BackgroundSwatch" Margin="4" BorderBrush="White" BorderThickness="1" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Panel" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PanelColorBox" Text="#0B0B10" TextChanged="AnyChanged" />
                    <Border    Grid.Row="1" Grid.Column="2" x:Name="PanelSwatch" Margin="4" BorderBrush="White" BorderThickness="1" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Border" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="BorderColorBox" Text="#FFFFFF" TextChanged="AnyChanged" />
                    <Border    Grid.Row="2" Grid.Column="2" x:Name="BorderSwatch" Margin="4" BorderBrush="White" BorderThickness="1" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Text" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TextColorBox" Text="#FFFFFF" TextChanged="AnyChanged" />
                    <Border    Grid.Row="3" Grid.Column="2" x:Name="TextSwatch" Margin="4" BorderBrush="White" BorderThickness="1" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Accent" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="AccentColorBox" Text="#FFD800" TextChanged="AnyChanged" />
                    <Border    Grid.Row="4" Grid.Column="2" x:Name="AccentSwatch" Margin="4" BorderBrush="White" BorderThickness="1" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Accent 2" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="Accent2ColorBox" Text="#00A2E8" TextChanged="AnyChanged" />
                    <Border    Grid.Row="5" Grid.Column="2" x:Name="Accent2Swatch" Margin="4" BorderBrush="White" BorderThickness="1" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Danger" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="6" Grid.Column="1" x:Name="DangerColorBox" Text="#FF3B3B" TextChanged="AnyChanged" />
                    <Border    Grid.Row="6" Grid.Column="2" x:Name="DangerSwatch" Margin="4" BorderBrush="White" BorderThickness="1" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Muted" VerticalAlignment="Center" />
                    <TextBox   Grid.Row="7" Grid.Column="1" x:Name="MutedColorBox" Text="#8A8AA0" TextChanged="AnyChanged" />
                    <Border    Grid.Row="7" Grid.Column="2" x:Name="MutedSwatch" Margin="4" BorderBrush="White" BorderThickness="1" />
                </Grid>

                <TextBlock Text="TYPOGRAPHY" Foreground="#FFD800" FontSize="18" FontWeight="Bold" Margin="0,14,0,6" />
                <TextBlock Text="Font family" />
                <ComboBox x:Name="FontBox" IsEditable="True" Text="Consolas" SelectionChanged="AnyChangedSelection" />
                <TextBlock x:Name="FontSizeLabel" Text="Font size: 15" />
                <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="24" Value="15" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="SliderChanged" />

                <TextBlock Text="ASSETS" Foreground="#FFD800" FontSize="18" FontWeight="Bold" Margin="0,14,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Logo image..." Width="150" Click="PickLogo_Click" />
                    <TextBlock x:Name="LogoText" Text="none" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Background..." Width="150" Click="PickBackground_Click" />
                    <TextBlock x:Name="BackgroundText" Text="none" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Music (mp3/wav)..." Width="150" Click="PickMusic_Click" />
                    <TextBlock x:Name="MusicText" Text="none" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Click sound..." Width="150" Click="PickClick_Click" />
                    <TextBlock x:Name="ClickText" Text="none" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="OpacityLabel" Text="Background image opacity: 35%" Margin="0,10,0,0" />
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="35" ValueChanged="SliderChanged" />
                <TextBlock x:Name="MusicVolumeLabel" Text="Music volume: 40%" />
                <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="100" Value="40" ValueChanged="SliderChanged" />
                <CheckBox x:Name="LoopBox" Content="Loop background music" IsChecked="True" Foreground="White" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ live preview ============ -->
        <Border Grid.Row="0" Grid.Column="1" Margin="10,4,4,4" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Image x:Name="PreviewBackground" Stretch="UniformToFill" Opacity="0.35" />
                <Border x:Name="PreviewRoot" Background="#000000" Padding="16">
                    <StackPanel>
                        <Border x:Name="PreviewHeader" BorderThickness="3" BorderBrush="White" Background="#0B0B10" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="PreviewLogo" Height="44" MaxWidth="240" Stretch="Uniform" />
                                <TextBlock x:Name="PreviewTitle" Text="DELTA DOT NET" FontSize="24" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="PreviewBody" BorderThickness="3" BorderBrush="White" Background="#0B0B10"
                                Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PreviewText1" Text="* Lobby: Kris and Susie" />
                                <TextBlock x:Name="PreviewText2" Text="* 2/2 players · open lobby" Margin="0,4,0,0" />
                                <TextBlock x:Name="PreviewMuted" Text="* the darkness is spreading..." Margin="0,4,0,0" />
                                <Border x:Name="PreviewButton" BorderThickness="2" BorderBrush="White" Padding="12,6"
                                        HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <TextBlock x:Name="PreviewButtonText" Text="START GAME" />
                                </Border>
                                <TextBlock x:Name="PreviewDanger" Text="* BAN PLAYER" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ toolbar ============ -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4,10,4,0">
            <Button Content="New" Width="100" Click="New_Click" />
            <Button Content="Open .ddntheme" Width="170" Margin="8,0,0,0" Click="Open_Click" />
            <Button Content="COMPILE .ddntheme" Width="220" Margin="8,0,0,0" Click="Compile_Click" />
            <Button Content="Compile + install to client" Width="250" Margin="8,0,0,0" Click="Install_Click" />
            <Button Content="Play music" Width="130" Margin="8,0,0,0" Click="PlayMusic_Click" />
            <Button Content="Stop" Width="90" Margin="8,0,0,0" Click="StopMusic_Click" />
            <TextBlock x:Name="StatusText" Margin="14,6,0,0" Foreground="#8A8AA0" Text="Ready." />
        </StackPanel>
    </Grid>
</Window>
