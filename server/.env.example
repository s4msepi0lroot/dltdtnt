# DeltaDotNet server configuration
# Copy to .env and load it with your process manager, or export these variables.

# TCP port the server listens on
PORT=8080
HOST=0.0.0.0

# Secret used to sign auth tokens. CHANGE THIS before going public!
DDN_SECRET=please-change-this-long-random-string

# The single account allowed into the admin panel
DDN_ADMIN_USERNAME=s4msepi0l

# Where db.json is stored (default: ./data)
DDN_DATA_DIR=./data
