# Порт HTTP/WebSocket
PORT=8080

# Секрет для подписи токенов. ОБЯЗАТЕЛЬНО поменяйте на своё длинное значение.
AUTH_SECRET=ВАШ_СЕКРЕТ

# Файл с учётками (создаётся автоматически)
DATA_FILE=./data/users.json

# Разрешить регистрацию новых игроков
ALLOW_REGISTER=true

# Максимальный размер одного кадра в килобайтах
MAX_FRAME_KB=2048

# Логин владельца админ-панели.
# Учётка с этим логином получает роль admin сразу при регистрации,
# её нельзя разжаловать, забанить или удалить.
ADMIN_LOGIN=s4msepi0l
