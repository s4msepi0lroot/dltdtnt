# Пример переменных окружения для релей-сервера DeltaDotNet.
# Скопируйте в .env или задайте в панели хостинга.

# Порт HTTP/WebSocket сервера
PORT=8080

# Секрет для подписи токенов (HMAC-SHA256). ОБЯЗАТЕЛЬНО смените!
# Пример генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-please

# Где хранить аккаунты (JSON-файл)
DATA_FILE=./data/users.json

# Разрешить самостоятельную регистрацию (1/0). После того как оба аккаунта созданы, поставьте 0.
ALLOW_REGISTER=1

# Максимальный размер одного WebSocket-кадра в килобайтах
MAX_FRAME_KB=2048
